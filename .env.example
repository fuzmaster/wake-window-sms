# Local server port
PORT=3000

# MVP JSON store path. This is the lightweight state layer for phone -> baby age/timezone/logs.
DB_PATH=./data/store.json

# Default user timezone before they text TZ America/New_York
DEFAULT_TIMEZONE=America/New_York

# Twilio setup notes:
# In Twilio Console, set your phone number Messaging webhook to:
# https://YOUR_PUBLIC_URL/sms/twilio
# Method: POST
